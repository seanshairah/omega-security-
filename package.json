{
  "name": "omega-protection-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Omega Protection Services operations portal: guard workforce and shift management over two-way SMS",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:purge": "tsx scripts/purge-data.ts --yes",
    "db:reset": "prisma migrate reset --force",
    "automation:tick": "tsx scripts/tick.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:gateway-e2e": "tsx scripts/dev/gateway-e2e.ts",
    "android:sync": "node scripts/android.mjs sync",
    "android:build": "node scripts/android.mjs build",
    "android:debug": "node scripts/android.mjs debug",
    "android:release": "node scripts/android.mjs release"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "geist": "^1.7.2",
    "https-proxy-agent": "^9.1.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "next": "^15.5.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.66.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "playwright-core": "^1.64.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
