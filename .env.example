# Database
DATABASE_OVER_HTTP=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"

# Auth — change in production (min 32 chars)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# SMS provider: simulated | sendai | africastalking | twilio | http
# Sendai (sendai.co.zw) is the recommended Zimbabwean gateway: SMS_API_KEY=sk_…, SMS_SENDER_ID=<approved sender identity>,
# SMS_WEBHOOK_SECRET=whsec_… from the webhook endpoint you register at https://<your-host>/api/sms/webhook/sendai
SMS_PROVIDER=simulated
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=OMEGASEC
SMS_WEBHOOK_SECRET=change-me
# Only for the generic HTTP provider
SMS_HTTP_SEND_URL=

# Automation engine
# On Vercel set AUTOMATION_INPROCESS=false and let the cron in vercel.json call /api/automation/tick (CRON_SECRET is checked too)
# Run the scheduler inside the Next.js process (true) or call POST /api/automation/tick from cron
AUTOMATION_INPROCESS=true
AUTOMATION_SECRET=change-me
TIMEZONE=Africa/Harare
CRON_SECRET=change-me

# Public URL of the portal, shown on the gateway activation card and used as the Android app's default server
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Browser push notifications (Web Push). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@omegasecurity.co.zw
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sendai WhatsApp / email sender identities (optional; auto-picked from the account if omitted)
SENDAI_WHATSAPP_IDENTITY_ID=
SENDAI_EMAIL_IDENTITY_ID=

# Google Maps for the duty-site picker in the admin portal (browser key; restrict it to your domain in Google Cloud).
# Enable "Maps JavaScript API", "Places API (New)" and "Geocoding API" on the key. Leave empty to use OpenStreetMap tiles instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# MapTiler raster tiles for the Leaflet maps (site picker, site map, live map) when no Google Maps key is set.
# Browser key: restrict it to your domain at MapTiler. Leave empty to use OpenStreetMap tiles. Tiles are only pictures;
# positions always come from the browser Geolocation API or a guard phone, never from the map.
NEXT_PUBLIC_MAPTILER_KEY=

# Android debug builds only: comma-separated hosts the DEBUG app may call over plain http:// (e.g. a laptop's LAN IP).
# Alternatively put `omega.devHttpHosts=192.168.1.20` in android/local.properties (not committed). Release builds ignore this.
# GATEWAY_DEV_HTTP_HOSTS=
