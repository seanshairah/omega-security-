# Database
DATABASE_OVER_HTTP=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"

# Auth — change in production (min 32 chars)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# SMS provider: simulated | sendai | africastalking | twilio | http
# Sendai (sendai.co.zw) is the recommended Zimbabwean gateway: SMS_API_KEY=sk_…, SMS_SENDER_ID=<approved sender identity>,
# SMS_WEBHOOK_SECRET=whsec_… from the webhook endpoint you register at https://<your-host>/api/sms/webhook/sendai
SMS_PROVIDER=simulated
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=OMEGASEC
SMS_WEBHOOK_SECRET=change-me
# Only for the generic HTTP provider
SMS_HTTP_SEND_URL=

# Automation engine
# On Vercel set AUTOMATION_INPROCESS=false and let the cron in vercel.json call /api/automation/tick (CRON_SECRET is checked too)
# Run the scheduler inside the Next.js process (true) or call POST /api/automation/tick from cron
AUTOMATION_INPROCESS=true
AUTOMATION_SECRET=change-me
TIMEZONE=Africa/Harare
CRON_SECRET=change-me
