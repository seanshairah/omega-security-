<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (v1.8). Top to bottom, in the order a guard needs it:
    compact header      who this phone is, online or not, Diagnostics
    attention           only when something needs doing (permission, battery, revoked)
    shift card          the primary area: on shift or not, the hours, the duty site, and where the
                        phone's last GPS reading put the guard
    primary actions     EMERGENCY, Need assistance, Shift going well, More
    location            the last check in one line, how often it checks, Check location now
    sent to operations  the last three alerts with their delivery state
    sync footer         fixed at the bottom: up to date / saved on the phone, Sync now
  Device details and the sync history live in Diagnostics. Edge to edge: the root takes the status
  bar inset, the footer the navigation bar inset.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface2">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/headerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/headerSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink2" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/connChip" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
        <ImageButton android:id="@+id/settings" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings" app:tint="@color/ink2" android:contentDescription="@string/diagnostics" />
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">

            <!-- Attention: one banner, only when something needs the person holding the phone. -->
            <LinearLayout android:id="@+id/attention" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" android:background="@drawable/bg_banner_amber" android:padding="14dp" android:visibility="gone">
                <TextView android:id="@+id/connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="14sp" android:lineSpacingExtra="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/permissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="48dp" android:text="@string/grant_permissions" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/battery" style="@style/Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="48dp" android:text="@string/battery_button" android:visibility="gone" />
            </LinearLayout>

            <!-- ================= GUARD MODE ================= -->
            <LinearLayout android:id="@+id/guardRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

                <!-- Shift: the primary area. -->
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <!-- Chips stack under each other when they do not fit: a wrapping row is
                             not something LinearLayout does, so each gets its own line at 320 dp. -->
                        <TextView android:id="@+id/shiftState" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/shiftTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
                        <TextView android:id="@+id/shiftSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/ink2" android:textSize="14sp" android:visibility="gone" />
                        <View style="@style/Divider" android:layout_marginTop="16dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="1dp" android:src="@drawable/ic_place" app:tint="@color/ink2" android:contentDescription="@null" />
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                                <TextView android:id="@+id/dutySiteName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" />
                                <TextView android:id="@+id/dutySiteMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/ink2" android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/presenceRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:background="@drawable/bg_stat" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
                            <ImageView android:id="@+id/presenceIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_verified" android:contentDescription="@null" />
                            <TextView android:id="@+id/presenceText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Primary actions -->
                <com.google.android.material.button.MaterialButton android:id="@+id/emergency" style="@style/Button.Emergency" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/emergency_button" app:icon="@drawable/ic_warning" />
                <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_banner_green" android:padding="14dp" android:textColor="@color/ink" android:textSize="14sp" android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:id="@+id/quickAssist" style="@style/ActionRow"><FrameLayout style="@style/ActionIconWrap" android:background="@drawable/circle_amber_soft"><ImageView style="@style/ActionIcon" android:src="@drawable/ic_people" app:tint="@color/warn_strong" /></FrameLayout><TextView style="@style/ActionText" android:text="@string/alert_assistance" /><ImageView style="@style/ActionChevron" /></LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout android:id="@+id/quickOk" style="@style/ActionRow"><FrameLayout style="@style/ActionIconWrap" android:background="@drawable/circle_green_soft"><ImageView style="@style/ActionIcon" android:src="@drawable/ic_thumb_up" app:tint="@color/accent" /></FrameLayout><TextView style="@style/ActionText" android:text="@string/alert_ok" /><ImageView style="@style/ActionChevron" /></LinearLayout>
                        <View style="@style/RowDivider" />
                        <LinearLayout android:id="@+id/quickMore" style="@style/ActionRow"><FrameLayout style="@style/ActionIconWrap" android:background="@drawable/circle_grey_soft"><ImageView style="@style/ActionIcon" android:src="@drawable/ic_more" app:tint="@color/ink2" /></FrameLayout><TextView style="@style/ActionText" android:text="@string/alerts_more" /><ImageView style="@style/ActionChevron" /></LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/unackedLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_pill_amber" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/warn_strong" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />

                <!-- Location -->
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/gps_card_label" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                            <FrameLayout android:id="@+id/gpsIconWrap" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_amber"><ImageView android:id="@+id/gpsIcon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_exclaim" app:tint="@color/surface" android:contentDescription="@null" /></FrameLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:id="@+id/gpsLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
                                <TextView android:id="@+id/gpsReasonLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/ink2" android:textSize="13.5sp" android:lineSpacingExtra="2dp" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/gpsMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/ink" android:textSize="13.5sp" android:lineSpacingExtra="2dp" />
                        <TextView android:id="@+id/monitoringLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink2" android:textSize="13sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/checkNow" style="@style/Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/check_location_now" app:icon="@drawable/ic_my_location" app:iconGravity="textStart" app:iconTint="@color/accent_strong" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sent to operations -->
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView style="@style/Label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/comm_label" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/commAll" style="@style/Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/comm_see_all" android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/commList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= OPERATIONS GATEWAY MODE ================= -->
            <LinearLayout android:id="@+id/opsRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <FrameLayout android:id="@+id/callIconWrap" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_green_soft"><ImageView android:id="@+id/callIcon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_phone" android:contentDescription="@null" /></FrameLayout>
                            <TextView android:id="@+id/callMonitorTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:id="@+id/callMonitorLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ink2" android:textSize="14sp" android:lineSpacingExtra="2dp" />
                        <View style="@style/Divider" android:layout_marginTop="16dp" />
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/last_call_label" />
                        <TextView android:id="@+id/lastCall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/ink" android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/recent_calls_label" />
                        <LinearLayout android:id="@+id/opsCalls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="@string/ops_call_note" android:textColor="@color/ink2" android:textSize="13sp" android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="@string/privacy_line" android:textColor="@color/ink3" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Sync footer: always visible, never touches GPS. -->
    <LinearLayout android:id="@+id/syncBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface">
        <View style="@style/Divider" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp">
            <ImageView android:id="@+id/syncIcon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                <TextView android:id="@+id/syncLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/syncDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink2" android:textSize="12.5sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/syncNow" style="@style/Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/sync_now" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
