<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/back" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/alerts_title" android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <Button android:id="@+id/emergency" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="12dp" android:backgroundTint="@color/critical" android:text="@string/emergency_button" android:textColor="@color/surface" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.06" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/emergency_hint" android:textColor="@color/ink2" android:textSize="12.5sp" />

        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alerts_quick_label" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <Button android:id="@+id/assistance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginEnd="6dp" android:text="@string/alert_assistance" android:textSize="13sp" />
            <Button android:id="@+id/incident" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="6dp" android:text="@string/alert_incident" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/security" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginEnd="6dp" android:text="@string/alert_security" android:textSize="13sp" />
            <Button android:id="@+id/late" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="6dp" android:text="@string/alert_late" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/ok" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginEnd="6dp" android:text="@string/alert_ok" android:textSize="13sp" />
            <Button android:id="@+id/status" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="6dp" android:text="@string/alert_status" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/handover" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginEnd="6dp" android:text="@string/alert_handover" android:textSize="13sp" />
            <Button android:id="@+id/callOps" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="6dp" android:text="@string/alert_call_ops" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/card" android:padding="12dp" android:textColor="@color/ink" android:textSize="13.5sp" android:visibility="gone" />

        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alert_history_label" />
        <LinearLayout android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/card" android:orientation="vertical" android:padding="14dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/alert_privacy" android:textColor="@color/ink3" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
