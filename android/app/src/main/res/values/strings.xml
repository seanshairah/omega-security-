    <!-- Permissions onboarding -->
    <string name="perm_title">Before your first shift</string>
    <string name="perm_intro">This phone is registered to you as a guard. During your shifts the app checks every few minutes whether the phone is inside your assigned site, and reports your calls to the operations room. Nothing is tracked outside shifts, and no audio is ever recorded.</string>
    <string name="perm_location">Location</string>
    <string name="perm_location_hint">Used only during shifts to tell whether you are inside the site. GPS works without airtime or data.</string>
    <string name="perm_background">Location all the time</string>
    <string name="perm_background_hint">Android needs “Allow all the time” so checks continue with the screen off.</string>
    <string name="perm_background_hint_r">Android needs “Allow all the time”. Tap below, open Permissions → Location and choose “Allow all the time”.</string>
    <string name="perm_phone">Phone and call log</string>
    <string name="perm_phone_hint">To report when you call operations or they call you: number, time and length only.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_hint">A small permanent notification keeps the app running during shifts.</string>
    <string name="perm_battery">Run in background</string>
    <string name="perm_battery_hint">Stops the phone from putting the app to sleep halfway through a shift.</string>
    <string name="perm_allow">Allow</string>
    <string name="perm_open_settings">Open settings</string>
    <string name="perm_summary">Location: %1$s · Phone: %2$s</string>
    <string name="perm_privacy">What is collected: your position during shifts (with its accuracy), call times and numbers, battery and network. What is not: audio, messages, contacts, photos, or your position outside shifts.</string>
    <string name="perm_done">Start</string>

