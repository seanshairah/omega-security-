generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users & access ─────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  phone        String?
  title        String?
  avatarUrl    String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supervisedGuards    Guard[]      @relation("GuardSupervisor")
  supervisedLocations Location[]   @relation("LocationSupervisor")
  supervisedShifts    Shift[]      @relation("ShiftSupervisor")
  supervisedIncidents Incident[]   @relation("IncidentSupervisor")
  recurrences         ShiftRecurrence[]
  auditLogs           AuditLog[]
  pushSubscriptions   PushSubscription[]
}

// ───────────────────────── Clients & locations ─────────────────────────

model Client {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  industry     String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  notes        String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  locations    Location[]
  smsMessages  SmsMessage[]
  callLogs     CallLog[]
}

enum ShiftPattern {
  DAY_8
  NIGHT_8
  DAY_12
  NIGHT_12
  CUSTOM
}

model Location {
  id                  String       @id @default(cuid())
  code                String       @unique
  name                String
  clientId            String
  client              Client       @relation(fields: [clientId], references: [id])
  siteType            String?
  address             String
  contactName         String?
  contactPhone        String?
  requiredGuards      Int          @default(1)
  shiftPattern        ShiftPattern @default(NIGHT_12)
  supervisorId        String?
  supervisor          User?        @relation("LocationSupervisor", fields: [supervisorId], references: [id])
  specialInstructions String?
  // Client site-status updates by SMS (arrival, welfare OK, shift ended, emergencies)
  clientUpdates       Boolean      @default(false)
  clientUpdatePhone   String?
  notifyClientArrival    Boolean   @default(true)
  notifyClientWelfare    Boolean   @default(true)
  notifyClientCompletion Boolean   @default(true)
  latitude            Float?
  longitude           Float?
  geofenceRadiusM     Int          @default(150)
  // Where the coordinates came from (map picker, typed by hand, temporary test values) and when they were set.
  coordinatesSource   CoordinatesSource?
  coordinatesUpdatedAt DateTime?
  coordinatesVerifiedAt DateTime?
  placeId             String?
  // Incremented whenever centre or radius changes; guard phones echo the version they applied.
  configVersion       Int          @default(1)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  guards      Guard[]
  shifts      Shift[]
  incidents   Incident[]
  recurrences ShiftRecurrence[]
  smsMessages SmsMessage[]
  gateways    GatewayDevice[]
  callLogs    CallLog[]
  locationEvents LocationEvent[]

  @@index([clientId])
  @@index([active])
}

// ───────────────────────── Guards ─────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  INACTIVE
}

model Guard {
  id                    String           @id @default(cuid())
  guardNo               String           @unique
  firstName             String
  lastName              String
  phone                 String           @unique
  nationalId            String           @unique
  gender                Gender           @default(MALE)
  dateOfBirth           DateTime?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  employmentStatus      EmploymentStatus @default(ACTIVE)
  dateEmployed          DateTime?
  supervisorId          String?
  supervisor            User?            @relation("GuardSupervisor", fields: [supervisorId], references: [id])
  homeLocationId        String?
  homeLocation          Location?        @relation(fields: [homeLocationId], references: [id])
  photoUrl              String?
  email                 String?
  notes                 String?
  active                Boolean          @default(true)
  deactivatedAt         DateTime?
  // Monitoring: admins can watch a guard closely; their events are highlighted and pushed.
  watched               Boolean          @default(false)
  watchedAt             DateTime?
  watchedById           String?
  watchNote             String?
  // ANDROID_GUARD once a guard device is linked; FEATURE_PHONE guards use SMS and calls only
  deviceKind            GuardDeviceKind  @default(FEATURE_PHONE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  shifts      Shift[]
  checkIns    ShiftCheckIn[]
  incidents   Incident[]
  smsMessages SmsMessage[]
  recurrences ShiftRecurrence[]
  notifications Notification[]
  callLogs    CallLog[]
  devices     GatewayDevice[]
  locationEvents LocationEvent[]

  @@index([lastName, firstName])
  @@index([active])
  @@index([homeLocationId])
  @@index([watched])
}

// ───────────────────────── Shifts ─────────────────────────

enum ShiftStatus {
  SCHEDULED
  AWAITING_ARRIVAL
  ON_DUTY
  LATE
  NOT_CONFIRMED
  ASSISTANCE
  INCIDENT
  CRITICAL
  COMPLETED
  MISSED
  CANCELLED
}

enum PendingPrompt {
  NONE
  ARRIVAL
  WELFARE
  INCIDENT_DESCRIPTION
  COMPLETION
}

model ShiftRecurrence {
  id           String    @id @default(cuid())
  guardId      String
  guard        Guard     @relation(fields: [guardId], references: [id])
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  supervisorId String?
  supervisor   User?     @relation(fields: [supervisorId], references: [id])
  daysOfWeek   Int[]     // 0 = Sunday … 6 = Saturday
  startTime    String    // "18:00"
  endTime      String    // "06:00"
  startsOn     DateTime
  endsOn       DateTime?
  instructions String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  shifts       Shift[]

  @@index([active])
}

model Shift {
  id              String        @id @default(cuid())
  guardId         String
  guard           Guard         @relation(fields: [guardId], references: [id])
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id])
  supervisorId    String?
  supervisor      User?         @relation("ShiftSupervisor", fields: [supervisorId], references: [id])
  recurrenceId    String?
  recurrence      ShiftRecurrence? @relation(fields: [recurrenceId], references: [id])
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  instructions    String?
  notes           String?
  status          ShiftStatus   @default(SCHEDULED)
  pendingPrompt   PendingPrompt @default(NONE)

  // Optional geofence override for this shift only (e.g. a gate post away from the site centre)
  geofenceLatitude  Float?
  geofenceLongitude Float?
  geofenceRadiusM   Int?
  geofenceNote      String?
  configVersion     Int           @default(1)

  // automation markers — each is set once, making the engine idempotent
  arrivalSmsSentAt        DateTime?
  arrivalReminderSentAt   DateTime?
  arrivalEscalatedAt      DateTime?
  welfareSmsSentAt        DateTime?
  welfareMissedAt         DateTime?
  handoverSmsSentAt       DateTime?
  completionSmsSentAt     DateTime?
  completionTimedOutAt    DateTime?
  emergencyAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance    Attendance?
  checkIns      ShiftCheckIn[]
  welfareChecks WelfareCheck[]
  incidents     Incident[]
  smsMessages   SmsMessage[]
  notifications Notification[]
  callLogs      CallLog[]
  locationEvents LocationEvent[]

  @@index([startAt])
  @@index([endAt])
  @@index([status])
  @@index([guardId, startAt])
  @@index([locationId, startAt])
}

enum AttendanceStatus {
  PENDING
  PRESENT
  LATE
  NOT_REPORTED
  COMPLETED
  LEFT_EARLY
  STILL_ON_DUTY
  INCIDENT
}

model Attendance {
  id                    String           @id @default(cuid())
  shiftId               String           @unique
  shift                 Shift            @relation(fields: [shiftId], references: [id])
  status                AttendanceStatus @default(PENDING)
  arrivalConfirmedAt    DateTime?
  lateMinutes           Int              @default(0)
  completionConfirmedAt DateTime?
  missedChecks          Int              @default(0)
  // GPS correlation of the SMS confirmation, for guards with an Android device
  locationVerification  LocationVerification @default(NOT_APPLICABLE)
  locationVerifiedAt    DateTime?
  updatedAt             DateTime         @updatedAt

  @@index([status])
}
enum LocationVerification {
  NOT_APPLICABLE
  VERIFIED
  EXCEPTION
  UNAVAILABLE
}
enum GuardDeviceKind {
  FEATURE_PHONE
  ANDROID_GUARD
}

enum CheckInType {
  SHIFT_STARTED
  ARRIVAL_SMS_SENT
  ARRIVAL_REMINDER_SENT
  ARRIVAL_CONFIRMED
  ARRIVAL_DENIED
  ARRIVAL_ESCALATED
  WELFARE_SMS_SENT
  WELFARE_OK
  WELFARE_ASSISTANCE
  WELFARE_INCIDENT
  WELFARE_MISSED
  INCIDENT_REPORTED
  EMERGENCY
  HANDOVER_NOTICE
  COMPLETION_SMS_SENT
  COMPLETION_CONFIRMED
  COMPLETION_DENIED
  COMPLETION_TIMEOUT
  SHIFT_COMPLETED
  SHIFT_MISSED
  SHIFT_CANCELLED
  ADMIN_NOTE
  CLIENT_NOTIFIED
  UNRECOGNISED_REPLY
  CALL_INCOMING
  CALL_ANSWERED
  CALL_ENDED
  CALL_MISSED
  CALL_OUTGOING
  LOCATION_VERIFIED
  LOCATION_EXCEPTION
  LOCATION_INSIDE
  LOCATION_EXIT
  LOCATION_OUTSIDE
  LOCATION_RETURNED
  LOCATION_UNAVAILABLE
  LOCATION_OVERDUE
}

enum CheckInSource {
  SMS
  SYSTEM
  ADMIN
  APP
}

model ShiftCheckIn {
  id           String        @id @default(cuid())
  shiftId      String
  shift        Shift         @relation(fields: [shiftId], references: [id])
  guardId      String
  guard        Guard         @relation(fields: [guardId], references: [id])
  type         CheckInType
  note         String?
  at           DateTime      @default(now())
  source       CheckInSource @default(SYSTEM)
  latitude     Float?
  longitude    Float?
  smsMessageId String?
  smsMessage   SmsMessage?   @relation(fields: [smsMessageId], references: [id])

  @@index([shiftId, at])
  @@index([guardId, at])
}

enum WelfareResponse {
  PENDING
  WELL
  ASSISTANCE
  INCIDENT
  NO_RESPONSE
}

model WelfareCheck {
  id          String          @id @default(cuid())
  shiftId     String
  shift       Shift           @relation(fields: [shiftId], references: [id])
  sentAt      DateTime        @default(now())
  respondedAt DateTime?
  response    WelfareResponse @default(PENDING)

  @@index([shiftId])
}

// ───────────────────────── Incidents ─────────────────────────

enum IncidentCategory {
  THEFT
  UNAUTHORIZED_ACCESS
  MEDICAL_EMERGENCY
  FIRE
  VIOLENCE
  EQUIPMENT_PROBLEM
  SUSPICIOUS_ACTIVITY
  ASSISTANCE_REQUEST
  EMERGENCY
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

enum IncidentSource {
  SMS
  ADMIN
  EMERGENCY
}

model Incident {
  id              String           @id @default(cuid())
  incidentNo      String           @unique
  guardId         String
  guard           Guard            @relation(fields: [guardId], references: [id])
  locationId      String
  location        Location         @relation(fields: [locationId], references: [id])
  shiftId         String?
  shift           Shift?           @relation(fields: [shiftId], references: [id])
  occurredAt      DateTime         @default(now())
  category        IncidentCategory @default(OTHER)
  severity        Severity         @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  description     String
  source          IncidentSource   @default(ADMIN)
  supervisorId    String?
  supervisor      User?            @relation("IncidentSupervisor", fields: [supervisorId], references: [id])
  acknowledgedAt  DateTime?
  resolutionNotes String?
  resolvedAt      DateTime?
  clientNotifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notifications   Notification[]

  @@index([status])
  @@index([occurredAt])
  @@index([guardId])
  @@index([locationId])
}

// ───────────────────────── SMS ─────────────────────────

enum SmsDirection {
  OUTBOUND
  INBOUND
}

enum SmsType {
  ARRIVAL
  ARRIVAL_REMINDER
  WELFARE
  INCIDENT
  ASSISTANCE
  COMPLETION
  HANDOVER
  EMERGENCY
  CLARIFICATION
  CLIENT_UPDATE
  GENERAL
}

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

model SmsMessage {
  id                String       @id @default(cuid())
  channel           MessageChannel @default(SMS)
  subject           String?
  direction         SmsDirection
  fromNumber        String
  toNumber          String
  body              String
  type              SmsType      @default(GENERAL)
  status            SmsStatus    @default(QUEUED)
  provider          String
  providerMessageId String?
  error             String?
  interpretedAs     String?
  guardId           String?
  guard             Guard?       @relation(fields: [guardId], references: [id])
  shiftId           String?
  shift             Shift?       @relation(fields: [shiftId], references: [id])
  locationId        String?
  location          Location?    @relation(fields: [locationId], references: [id])
  clientId          String?
  client            Client?      @relation(fields: [clientId], references: [id])
  createdAt         DateTime     @default(now())
  checkIns          ShiftCheckIn[]

  @@index([createdAt])
  @@index([guardId, createdAt])
  @@index([shiftId])
  @@index([type])
  @@index([direction])
  @@index([channel])
  @@index([clientId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model MessageTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  body        String
  variables   String[]
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ───────────────────────── Settings, notifications, audit ─────────────────────────

model Setting {
  key         String   @id
  value       String
  label       String
  description String?
  group       String   @default("automation")
  updatedAt   DateTime @updatedAt
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id         String               @id @default(cuid())
  type       String
  severity   NotificationSeverity @default(INFO)
  title      String
  body       String
  guardId    String?
  guard      Guard?               @relation(fields: [guardId], references: [id])
  shiftId    String?
  shift      Shift?               @relation(fields: [shiftId], references: [id])
  incidentId String?
  incident   Incident?            @relation(fields: [incidentId], references: [id])
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([readAt])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  actor     String   // display name or "system"
  action    String   // e.g. GUARD_CREATED
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entity, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Android call gateway. Separate from the SMS system: a gateway phone reports
// call metadata (never audio) which is matched to guards and live shifts.
// ─────────────────────────────────────────────────────────────────────────────
enum GatewayStatus {
  ONLINE
  OFFLINE
  DISABLED
  REVOKED
}
enum GatewayActivation {
  PENDING
  ACTIVE
  REVOKED
}
model GatewayDevice {
  id               String            @id @default(cuid())
  deviceName       String
  phoneNumber      String
  locationId       String?
  location         Location?         @relation(fields: [locationId], references: [id])
  // One app, two modes: an operations gateway phone, or a guard's own phone
  mode             DeviceMode        @default(OPERATIONS_GATEWAY)
  guardId          String?
  guard            Guard?            @relation(fields: [guardId], references: [id])
  locationPermission String?         // granted | foreground_only | denied | unknown
  callPermission   String?           // granted | partial | denied | unknown
  monitoringState  String?           // NOT_ON_SHIFT … SYNCING, reported by the phone
  mockLocationSeen Boolean           @default(false)
  lastLatitude     Float?
  lastLongitude    Float?
  lastAccuracyM    Float?
  lastLocationAt   DateTime?
  lastLocationState LocationState?
  // Shift config the phone reports it applied ("<siteVersion>.<shiftVersion>" of the shift it monitors)
  configVersionApplied String?
  configAppliedAt  DateTime?
  status           GatewayStatus     @default(OFFLINE)
  activationStatus GatewayActivation @default(PENDING)
  activationCode   String?           @unique
  activationExpiresAt DateTime?
  activatedAt      DateTime?
  tokenHash        String?           @unique
  tokenIssuedAt    DateTime?
  lastSeenAt       DateTime?
  lastIp           String?
  androidVersion   String?
  appVersion       String?
  deviceModel      String?
  batteryLevel     Int?
  networkType      String?
  lastCallAt       DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  revokedAt        DateTime?
  disabledAt       DateTime?

  events   GatewayEvent[]
  callLogs CallLog[]
  locationEvents LocationEvent[]

  @@index([status])
  @@index([locationId])
  @@index([lastSeenAt])
  @@index([guardId])
}
enum DeviceMode {
  OPERATIONS_GATEWAY
  GUARD
}
enum CoordinatesSource {
  MAP
  MANUAL
  TEST
}

enum LocationState {
  INSIDE
  OUTSIDE
  UNKNOWN
}
enum LocationEventType {
  SHIFT_STARTED
  LOCATION_CHECK
  LOCATION_EXIT
  LOCATION_OUTSIDE
  LOCATION_RETURNED
  LOCATION_UNAVAILABLE
  LOCATION_VERIFICATION_OVERDUE
  LOCATION_CALL
}
enum SyncStatus {
  LIVE
  SYNCED
  SYNCED_LATE
}
/**
 * Location events from guard devices. Event-focused: arrival, periodic checks, exit, outside
 * updates, return, unavailable. Not a GPS stream. `syncStatus` is derived from the delay between
 * the phone's timestamp and arrival at the server, so a late upload is never shown as live.
 */
model LocationEvent {
  id              String            @id @default(cuid())
  eventId         String            @unique
  gatewayDeviceId String
  device          GatewayDevice     @relation(fields: [gatewayDeviceId], references: [id])
  guardId         String?
  guard           Guard?            @relation(fields: [guardId], references: [id])
  shiftId         String?
  shift           Shift?            @relation(fields: [shiftId], references: [id])
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id])
  eventType       LocationEventType
  locationState   LocationState     @default(UNKNOWN)
  latitude        Float?
  longitude       Float?
  accuracyM       Float?
  distanceM       Float?
  geofenceRadiusM Int?
  provider        String?
  speed           Float?
  bearing         Float?
  mock            Boolean           @default(false)
  reason          String?           // for LOCATION_UNAVAILABLE: permission_revoked, location_disabled, no_fix, poor_accuracy, …
  durationOutsideSeconds Int?
  occurredAt      DateTime
  receivedAt      DateTime          @default(now())
  syncStatus      SyncStatus        @default(LIVE)
  simulated       Boolean           @default(false)
  metadata        Json?

  @@index([shiftId, occurredAt])
  @@index([guardId, occurredAt])
  @@index([gatewayDeviceId, occurredAt])
  @@index([eventType])
  @@index([occurredAt])
}
/** Every event a gateway sends, kept raw. `eventId` is generated on the phone and makes retries idempotent. */
model GatewayEvent {
  id              String        @id @default(cuid())
  eventId         String        @unique
  gatewayDeviceId String
  gateway         GatewayDevice @relation(fields: [gatewayDeviceId], references: [id])
  eventType       String
  callId          String?
  phoneNumber     String?
  occurredAt      DateTime
  receivedAt      DateTime      @default(now())
  payload         Json?
  outcome         String?

  @@index([gatewayDeviceId, receivedAt])
  @@index([eventType])
}
enum CallDirection {
  INCOMING
  OUTGOING
}
enum CallStatus {
  RINGING
  ANSWERED
  MISSED
  ENDED
  FAILED
  UNKNOWN
}
model CallLog {
  id                    String        @id @default(cuid())
  callId                String        // stable id from the phone for one call; dedupes state events
  gatewayDeviceId       String
  gateway               GatewayDevice @relation(fields: [gatewayDeviceId], references: [id])
  guardId               String?
  guard                 Guard?        @relation(fields: [guardId], references: [id])
  locationId            String?
  location              Location?     @relation(fields: [locationId], references: [id])
  clientId              String?
  client                Client?       @relation(fields: [clientId], references: [id])
  shiftId               String?
  shift                 Shift?        @relation(fields: [shiftId], references: [id])
  phoneNumber           String
  normalizedPhoneNumber String
  direction             CallDirection @default(INCOMING)
  status                CallStatus    @default(RINGING)
  startedAt             DateTime
  answeredAt            DateTime?
  endedAt               DateTime?
  durationSeconds       Int?
  unknownCaller         Boolean       @default(false)
  unknownResolution     String?       // IGNORED | BLOCKED | LINKED
  simulated             Boolean       @default(false)
  note                  String?
  // Guard-device calls carry the latest fix; a gateway call and a guard call for the same
  // conversation are linked both ways.
  latitude              Float?
  longitude             Float?
  locationState         LocationState?
  correlatedCallId      String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([gatewayDeviceId, callId])
  @@index([startedAt])
  @@index([status])
  @@index([guardId, startedAt])
  @@index([locationId, startedAt])
  @@index([normalizedPhoneNumber])
  @@index([unknownCaller])
}
